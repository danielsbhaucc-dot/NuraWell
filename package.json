{
  "name": "weight-loss-course-system",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered weight loss course system - Mobile First",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo run test --filter=@weight-loss/web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > packages/shared/types/database.ts",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "next": "16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "^8.5.29"
  }
}
