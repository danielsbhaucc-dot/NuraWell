{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": [
    "fra1"
  ],
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/v1/ai/cron/field-backfill",
      "schedule": "40 11 * * *"
    },
    {
      "path": "/api/v1/legal/anchor",
      "schedule": "17 2 * * *"
    },
    {
      "path": "/api/v1/legal/ots-upgrade",
      "schedule": "47 4 * * *"
    },
    {
      "path": "/api/v1/ai/cron/log-retention",
      "schedule": "23 1 * * *"
    }
  ]
}
