{
  "name": "@weight-loss/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eslint . --quiet && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npx vitest run",
    "test:a11y": "npx vitest run tests/a11y-preferences.test.ts tests/a11y-alt-text.test.ts tests/a11y-count-active.test.ts tests/a11y-axe-smoke.test.ts",
    "test:a11y:e2e": "npx playwright test tests/e2e/a11y-pages.spec.ts",
    "test:a11y:all": "npm run test:a11y && npm run test:a11y:e2e",
    "playwright:install": "npx playwright install chromium",
    "test:watch": "vitest",
    "backfill:insight-vectors": "node --env-file=.env.local scripts/backfill-insight-vectors-upstash.mjs",
    "test:e2e:signed-in": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-https://nurawell.vercel.app} playwright test --project=signed-in-mobile"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/react": "^4.0.140",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@hebcal/core": "^6.5.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/workflow": "^1.2.1",
    "@zip.js/zip.js": "^2.24.0",
    "ai": "^7.0.137",
    "bidi-js": "^1.1.0",
    "clsx": "^2.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^1.34.0",
    "mailauth": "^8.0.1",
    "marked": "^18.1.1",
    "next": "^16.4.3",
    "openai": "^7.32.0",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.7.6",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.0",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "axe-core": "^4.10.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
