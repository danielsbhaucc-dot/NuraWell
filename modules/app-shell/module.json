{
  "$schema": "../area.schema.json",
  "id": "app-shell",
  "name": "מעטפת האפליקציה",
  "kind": "area",
  "distribution": "internal",
  "category": "ui",
  "core": true,
  "toggleable": false,
  "alwaysOn": [
    "layout",
    "error-pages"
  ],
  "owns": [
    "apps/web/components/ui/",
    "apps/web/components/shared/",
    "apps/web/components/home/",
    "apps/web/lib/client/",
    "apps/web/lib/hooks/",
    "apps/web/lib/dom/",
    "apps/web/lib/navigation/",
    "apps/web/lib/text/",
    "apps/web/lib/time/",
    "apps/web/lib/types/",
    "apps/web/lib/theme/",
    "apps/web/lib/ui/",
    "apps/web/lib/routing/",
    "apps/web/lib/validation/",
    "apps/web/lib/supabase/",
    "apps/web/lib/api/",
    "apps/web/lib/i18n/",
    "apps/web/lib/date/",
    "apps/web/lib/emoji-from-text.ts",
    "apps/web/lib/cn.ts",
    "apps/web/lib/public-app-url.ts",
    "apps/web/lib/sanitize-lesson-html.ts",
    "apps/web/types/",
    "apps/web/proxy.ts",
    "apps/web/lib/actions/",
    "apps/web/app/(dashboard)/layout.tsx",
    "apps/web/app/(dashboard)/home/",
    "apps/web/app/layout.tsx",
    "apps/web/app/fonts.ts",
    "apps/web/components/not-found/",
    "apps/web/.env.example",
    "apps/web/.npmrc",
    "apps/web/playwright.config.ts",
    "apps/web/playwright.visual.config.ts",
    "apps/web/vitest.config.ts",
    "apps/web/scripts/codemod-palette.mjs",
    "apps/web/scripts/design-lint.mjs",
    "apps/web/scripts/design-lint-baseline.json",
    "apps/web/scripts/near-white.mjs",
    "apps/web/scripts/route-inventory.mjs",
    "apps/sample-product/"
  ],
  "description": "App shell: layout, navigation, shared UI, data clients, loading/error/404."
}
