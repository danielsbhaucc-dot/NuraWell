{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform module manifest (module.json)",
  "type": "object",
  "required": [
    "id",
    "package",
    "version",
    "distribution",
    "category",
    "toggleable",
    "description",
    "requires",
    "env",
    "migrations",
    "conformance"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "package": {
      "type": "string",
      "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "distribution": {
      "enum": [
        "internal",
        "shareable",
        "sellable"
      ]
    },
    "category": {
      "enum": [
        "security",
        "privacy",
        "platform",
        "feature",
        "ui",
        "ops"
      ]
    },
    "toggleable": {
      "type": "boolean",
      "description": "false = always on (security/privacy modules)"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "provides": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array"
        },
        "apis": {
          "type": "array"
        },
        "jobs": {
          "type": "array"
        },
        "ui": {
          "type": "array"
        },
        "tables": {
          "type": "array"
        }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "description": "env var NAMES only, never values"
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conformance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataPolicy": {
      "type": "string"
    },
    "frozen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sale": {
      "type": "object",
      "description": "Only for distribution=sellable. bundle = minified, watermarked, signed (default); source = full-source buyout. serverCore is reserved (documented, not implemented).",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "bundle",
              "source"
            ]
          }
        },
        "serverCore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "store": {
      "type": "object",
      "description": "Plugin-store page in plain Hebrew (required by modules check)",
      "required": [
        "name",
        "summary",
        "audience",
        "useCases",
        "features",
        "dataTouched",
        "permissions",
        "security",
        "whereDataLives",
        "installConfig",
        "compatibility",
        "limitations",
        "support"
      ],
      "properties": {
        "iamModule": {
          "type": "string",
          "description": "id in the product IAM module registry that this package's per-product switch controls"
        }
      }
    },
    "tier": {
      "type": "string",
      "description": "Shared with platform-core (fx-* modules): free-form tier label, e.g. core | standard | premium | fx"
    },
    "theme": {
      "type": "object",
      "description": "Design tokens the module reads (CSS variables). No hardcoded colors/fonts.",
      "properties": {
        "tokens": {
          "type": "string",
          "description": "path to tokens.json or tokens.css"
        },
        "vars": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^--[a-z0-9-]+$"
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "named markup slots/overrides the module exposes"
    },
    "embed": {
      "type": "object",
      "description": "Only for sellable modules embedded at a customer site",
      "properties": {
        "script": {
          "type": "string"
        },
        "npm": {
          "type": "string"
        },
        "keyRequired": {
          "type": "boolean"
        },
        "allowedOrigins": {
          "type": "boolean"
        },
        "metering": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signed": {
          "type": "boolean"
        },
        "sbom": {
          "type": "string"
        }
      }
    },
    "repo": {
      "type": "string",
      "description": "home repo of the module when it lives outside this library (e.g. platform-core for fx-*)"
    }
  }
}
